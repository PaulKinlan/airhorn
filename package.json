{
  "name": "airhorn",
  "version": "2.0.0",
  "type": "module",
  "description": "A sample web app that lets you use your site as an airhorn.",
  "private": true,
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vite build && node --test --test-concurrency=1 \"tests/**/*.test.js\" \"tests/**/*.test.mjs\" \"test/**/*.test.js\" \"test/**/*.test.mjs\"",
    "test:acceptance": "vite build && node tests/acceptance.mjs"
  },
  "devDependencies": {
    "vite": "^6.2.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GoogleChrome/airhorn.git"
  },
  "author": "Paul Kinlan",
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/GoogleChrome/airhorn/issues"
  },
  "homepage": "https://github.com/GoogleChrome/airhorn#readme"
}
